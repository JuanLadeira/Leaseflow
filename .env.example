# Copy to .env (git-ignored). Read by the backend service in every compose file.
DJANGO_SECRET_KEY=change-me
JWT_SECRET=change-me-too
# Optional: real AI suggestions. Without it, the assistant streams an offline template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
POSTGRES_PASSWORD=leaseflow
# MCP server: the public URL agents connect to. Agent tokens are bound to it (JWT `aud`).
MCP_RESOURCE_URL=http://localhost:8000/mcp
